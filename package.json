{
  "name": "readme-generator",
  "version": "1.0.1",
  "description": "AI-powered README Generator desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "marked": "^12.0.1",
    "mermaid": "^10.9.0"
  },
  "devDependencies": {
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.antigravity.readme-generator",
    "productName": "README Generator",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "renderer/assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!dist/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
